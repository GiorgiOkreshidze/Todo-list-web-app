@model IEnumerable<TodoListApp.WebApi.Models.TodoListDto>

@{
    ViewData["Title"] = "My To-do Lists";
}

<div class="container mt-5 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div class="py-3">
            <h1 class="fw-bold text-dark mb-1">My To-do Lists</h1>
            <p class="text-muted small mb-0 my-2">Manage and organize your tasks</p>
        </div>
        <div class="py-3">
            <a asp-action="Create"
               asp-controller="TodoList"
               class="btn btn-outline-primary rounded-2 px-3 fw-bold">
                Create New List
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <p class="mb-0 fs-5">No to-do lists found. Click "Create New List" to get started!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                        <tr class="table-light border-bottom">
                            <th class="ps-4 py-3 text-uppercase text-muted fw-bold small col-1">
                                @Html.DisplayNameFor(model => model.Id)
                            </th>
                            <th class="py-3 text-uppercase text-muted fw-bold small col-3">
                                @Html.DisplayNameFor(model => model.Name)
                            </th>
                            <th class="py-3 text-uppercase text-muted fw-bold small col-5">
                                @Html.DisplayNameFor(model => model.Description)
                            </th>
                            <th class="py-3 text-center text-uppercase text-muted fw-bold small col-3">
                                Actions
                            </th>
                        </tr>
                        </thead>

                        <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 font-monospace text-secondary small">
                                    @Html.DisplayFor(modelItem => item.Id)
                                </td>
                                <td class="fw-bold text-dark fs-6">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td style="max-width: 200px;">
                                    <span class="text-secondary text-truncate d-block">
                                        @Html.DisplayFor(modelItem => item.Description)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-2 justify-content-center align-items-center">
                                        <a asp-controller="TodoTask"
                                           asp-action="Index"
                                           asp-route-listId="@item.Id"
                                           class="btn btn-sm btn-secondary rounded-2">
                                            Tasks
                                        </a>
                                        <a asp-action="Edit"
                                           asp-controller="TodoList"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary rounded-2" title="Edit">
                                            Edit
                                        </a>
                                        <a asp-action="Delete"
                                           asp-controller="TodoList"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger rounded-2" title="Delete">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>