@model IEnumerable<TodoListApp.WebApi.Models.TodoListDto>

@{
    ViewData["Title"] = "My To-do Lists";
}

<div class="container mt-5">
    <div class="justify-content-center align-items-center mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div class="p-3 col-6">
                <h1 class="fw-bold text-dark mb-1">My To-do Lists</h1>
                <p class="text-muted small mb-0">Manage and organize your tasks</p>
            </div>
            <div class="p-3 col-2 text-end">
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                    Create New List
                </a>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <p class="mb-0 fs-5">No to-do lists found. Click "Create New List" to get started!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <tr class="table-light border-bottom">
                            <th class="ps-4 py-3 text-uppercase text-muted fw-bold small col-1">
                                @Html.DisplayNameFor(model => model.Id)
                            </th>
                            <th class="py-3 text-uppercase text-muted fw-bold small col-3">
                                @Html.DisplayNameFor(model => model.Name)
                            </th>
                            <th class="py-3 text-uppercase text-muted fw-bold small col-5">
                                @Html.DisplayNameFor(model => model.Description)
                            </th>
                            <th class="pe-4 py-3 text-end text-uppercase text-muted fw-bold small col-3">
                                Actions
                            </th>
                        </tr>

                        @foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 font-monospace text-secondary small">
                                    @Html.DisplayFor(modelItem => item.Id)
                                </td>
                                <td class="fw-bold text-dark fs-6">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td>
                                    <span class="text-secondary text-truncate d-inline-block w-100">
                                        @Html.DisplayFor(modelItem => item.Description)
                                    </span>
                                </td>
                                <td class="p-4 text-end">
                                    <div class="btn-group gap-1">
                                        <a asp-controller="TodoTask" asp-action="Index" asp-route-listId="@item.Id"
                                           class="btn btn-sm btn-outline-primary rounded-3 p-2">
                                            Tasks
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info rounded-3 p-2" title="Edit">
                                            Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger rounded-3 p-2" title="Delete">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </table>
                </div>
            }
        </div>
    </div>
</div>