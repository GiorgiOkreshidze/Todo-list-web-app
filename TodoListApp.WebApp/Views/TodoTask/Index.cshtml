@model IEnumerable<TodoListApp.WebApi.Models.TodoTaskDto>

@{
    ViewData["Title"] = "Index";
}

<div class="container mt-5">
    <div class="justify-content-center align-items-center mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div class="p-3 col-6">
                <h1 class="fw-bold text-dark mb-1">Tasks</h1>
            </div>
            <div>
                <a asp-action="Create"
                   asp-route-ListId="@ViewData["ListId"]"
                   class="btn btn-outline-primary rounded-2 px-3 fw-bold">
                    Create New Task
                </a>
            </div>
        </div>

        <form asp-action="Index" method="get">
            <div class="input-group mb-3">
                <input type="text"
                       name="SearchString"
                       class="form-control"
                       placeholder="Search by Name"
                       aria-label="Search"
                       aria-describedby="button-addon2"
                       value="@ViewData["CurrentFilter"]"
                />
                <button class="btn btn-outline-secondary"
                        type="submit"
                        id="button-addon2">
                    Button
                </button>
            </div>
        </form>

        <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase text-muted fw-bold small">
                                @Html.DisplayNameFor(model => model.Id)
                            </th>
                            <th class="py-3 text-uppercase text-muted fw-bold small">
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["NameSortParm"]"
                                   asp-route-listId="@ViewData["ListId"]">
                                    @Html.DisplayNameFor(model => model.Name)
                                </a>
                            </th>
                            <th class="py-3 text-uppercase text-muted fw-bold small">
                                @Html.DisplayNameFor(model => model.Description)
                            </th>
                            <th class="py-3 text-uppercase text-muted fw-bold small">
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["DateSortParm"]"
                                   asp-route-listId="@ViewData["ListId"]">
                                    @Html.DisplayNameFor(model => model.DueDate)
                                </a>
                            </th>
                            <th class="py-3 text-uppercase text-muted fw-bold small">
                                @Html.DisplayNameFor(model => model.Status)
                            </th>
                            <th class="pe-4 py-3 text-end text-uppercase text-muted fw-bold small">
                                Actions
                            </th>
                        </tr>
                        </thead>


                        @foreach (var item in Model)
                        {
                            bool isOverdue = item.DueDate < DateTime.Now && !item.Status;
                            string rowClass = isOverdue ? "table-danger" : "";

                            <tr class="border-bottom @rowClass">
                                <td class="ps-4 font-monospace text-secondary small">
                                    @Html.DisplayFor(modelItem => item.Id)
                                </td>
                                <td class="fw-bold text-dark fs-6">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td>
                                    <span class="text-secondary text-truncate d-inline-block w-100 text-center">
                                        @Html.DisplayFor(modelItem => item.Description)
                                    </span>
                                </td>
                                <td class="fw-bold text-dark fs-6">
                                    @Html.DisplayFor(modelItem => item.DueDate)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Status)
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-2 justify-content-center align-items-center">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           asp-route-listId="@ViewData["ListId"]"
                                           class="btn btn-outline-primary btn-sm rounded-2 px-3">
                                            Edit
                                        </a>
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           asp-route-listId="@ViewData["ListId"]"
                                           class="btn btn-outline-secondary btn-sm rounded-2 px-3">
                                            Details
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           asp-route-listId="@ViewData["ListId"]"
                                           class="btn btn-outline-danger btn-sm rounded-2 px-3">
                                            Delete
                                        </a>

                                        @if (!item.Status)
                                        {
                                            <input type="button"
                                                   value="Complete"
                                                   class="btn btn-primary btn-sm rounded-2 px-3"
                                                   onclick="location.href='@Url.Action("MakeItDone", "TodoTask", new { id = item.Id, listId = ViewData["ListId"] })'"/>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>

        <div>
            <a asp-controller="TodoList"
               asp-action="Index"
               asp-route-listId="@ViewData["ListId"]"
               class="btn btn-outline-secondary rounded-pill px-3 shadow-sm fw-bold mt-5">
                <i class="bi bi-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>
</div>