@model TodoListApp.WebApi.Models.UpdateTodoTaskCommentDto

@{
    ViewData["Title"] = "EditComment";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-5 text-center">
                    <h2 class="fw-bold mb-4">Edit</h2>
                    <form asp-action="EditComment"
                          asp-route-taskId="@ViewData["TaskId"]"
                          asp-route-listId="@ViewData["ListId"]">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="Id" class="form-control" placeholder="Id"/>
                            <label asp-for="Id">Id</label>
                            <span asp-validation-for="Id" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-4">
                            <input asp-for="Description" class="form-control" placeholder="Description"/>
                            <label asp-for="Description">Description</label>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3 shadow-sm">Edit</button>
                    </form>

                    <div>
                        <a asp-action="Details"
                           asp-route-id="@ViewData["TaskId"]"
                           asp-route-listId="@ViewData["ListId"]"
                           class="btn btn-outline-secondary w-100 text-decoration-none">
                            Back to Task Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
